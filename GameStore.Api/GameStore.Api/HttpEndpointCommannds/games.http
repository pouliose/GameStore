@baseUrl = http://localhost:5225

### GET GAMES
GET {{baseUrl}}/games?page=1&pageSize=20

### GET GAME
GET {{baseUrl}}/games/1

### CREATE GAME
POST {{baseUrl}}/games
Content-Type: application/json

{
    "name": "New Game 25-09 E",
    "genreId": 1,
    "price": 22.22,
    "releaseDate": "2026-02-09"
}

### UPDATE GAME
PUT {{baseUrl}}/games/4002
Content-Type: application/json

{
    "name": "Stardew Valley",
    "genreId": 2,
     "price": 14.99,
    "releaseDate": "2016-02-26"
}

### DELETE GAME
DELETE {{baseUrl}}/games/3003